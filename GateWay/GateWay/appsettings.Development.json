{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {

      "order-get-all": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/GetAllOrders",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "AdminOnly",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "order-get-by-user": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "CustomerOrAdmin",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "order-get-by-id": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/{orderId}",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "CustomerOrAdmin",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "order-create": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "CustomerOrAdmin",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "order-cancel": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/{orderId}/cancel",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "CustomerOrAdmin",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "order-complete": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/{orderId}/complete",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "CustomerOrAdmin",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "order-swagger-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order/swagger/{**catch-all}"
        },
        "AuthorizationPolicy": "Anonymous",
        "Transforms": [
          {
            "PathRemovePrefix": "/order"
          }
        ]
      },

      "inventory-get-all": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "AdminOnly",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "inventory-get-by-id": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{id:guid}",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "AllowAnonymous",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "inventory-create": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "AdminOnly",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "inventory-update": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{id:guid}",
          "Methods": [ "PUT" ]
        },
        "AuthorizationPolicy": "AdminOnly",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "inventory-delete": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{id:guid}",
          "Methods": [ "DELETE" ]
        },
        "AuthorizationPolicy": "AdminOnly",
        "Metadata": {
          "RequireAuthenticatedUser": "true"
        }
      },

      "inventory-swagger-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/swagger/{**catch-all}"
        },
        "AuthorizationPolicy": "Anonymous",
        "Transforms": [
          {
            "PathRemovePrefix": "/inventory"
          }
        ]
      }

    },

    "Clusters": {
      "order-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "order-api": {
            "Address": "https://localhost:7211/"
          }
        }
      },

      "inventory-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "inventory-api": {
            "Address": "https://localhost:7212/"
          }
        }
      }
    }
  }
}
